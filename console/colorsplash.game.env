# Paper Mario Color Splash: read by launch.sh before the start.
# Battle cards and the map are on the GamePad: a left stick click switches to the GamePad picture and back;
# there the right stick moves a touch cursor, ZR or a right stick click touches (cards also work with the buttons).
export CAFE_TOUCH_UI=1
# Guest memory (MEM2) as GPU memory (see maker/game.env): console 25-29 -> steady 30 fps (the game's own rate).
export TTT2_GUEST_DMABUF=1
